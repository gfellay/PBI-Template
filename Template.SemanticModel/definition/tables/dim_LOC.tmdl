	partition dim_LOC = m
		mode: import
		source =
				let
				    Origen = Oracle.Database("DBLIVEDG", [HierarchicalNavigation=true, Query="SELECT#(lf)    loc_cd loc#(lf)    ,loc_sap#(lf)    ,DESCR location#(lf)    ,loc_type#(lf)    ,country #(lf)    ,CASE #(lf)    #(tab)WHEN country = 'MX' THEN 'PMF'#(lf)    #(tab)WHEN country = 'BR' THEN 'PBF'#(lf) #(tab)#(tab)WHEN country IN ('AR', 'CL', 'UY', 'PY') THEN#(tab)'SOCO'#(lf) #(tab)#(tab)WHEN country IN ('CO', 'EC', 'PE', 'VE', 'BO')#(tab)THEN 'ANDINOS'#(lf) #(tab)#(tab)WHEN country IN ('GT', 'DO', 'PR', 'SV', 'PA', 'NI', 'CR', 'HN', 'RC') THEN 'CARICAM'#(lf) #(tab)#(tab)ELSE 'REVISAR'#(tab)#(tab)#(lf) #(tab)END AS ""OU""#(lf) #(tab),upper(region) region#(lf) #(tab),DP_ALT #(lf) #(tab),status#(lf) #(tab),LATITUD #(lf) #(tab),LONGITUD#(lf) #(tab), PALLETCAP #(lf)FROM#(lf)    apexstg.a_loc#(lf)WHERE#(lf)    loc_type NOT IN ('SU', 'CB')#(lf)AND status != 0", CreateNavigationProperties=false])
				in
				    Origen

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

