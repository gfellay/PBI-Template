	partition dim_ITEM = m
		mode: import
		source =
				let
				    Origen = Oracle.Database("DBLIVEDG", [HierarchicalNavigation=true, Query="SELECT#(lf)    i.ITEMGROUP#(lf)    ,i.ITEM_SAP#(lf)    ,i.ITEM_SAP || '_' || i.ACTIVE clave_sap#(lf)    ,i.DESCR#(tab)#(tab)producto#(lf)    ,i.ITEM_TYPE#(lf)    ,i.UMB #(lf)    ,CASE i.product_line_desc#(lf)    #(tab)WHEN 'COOKIES AND CRACKERS' THEN 'CnC'#(lf)    #(tab)WHEN 'SAVOURY SNACKS' THEN 'SALTY'#(lf)    #(tab)WHEN 'NON CARBONATED BEVERAGE(NCB)' THEN 'NCB'#(lf)    #(tab)ELSE i.product_line_desc    #(tab)#(lf)    END bu#(lf)    ,i.BRAND_GROUP_DESC#(tab)#(tab)brand_group#(lf)    ,i.BRAND_DESC#(tab)brand#(lf)    ,i.SUBBRAND_DESC#(tab)sub_brand#(lf)    ,i.CUSTOM10 AS TECNOLOGIA#(lf)    ,m.DEPT_DESCP  AS DEPARTAMENTO#(lf)    ,m.SHAPE_DESCP AS SHAPE#(lf)    ,m.FLVR_DESCP  AS FLAVOR#(lf)    ,i.EACHXBOX#(lf)    ,i.GRSXBAG#(lf)    ,i.EACHXBOX * i.GRSXBAG / 1000   kg_x_cs#(lf)    ,i.BOXXPALLET#(lf)    , i.active#(lf)FROM APEXSTG.A_ITEM_VW i#(lf)LEFT JOIN STAGING.STG_IN_MAKECODE m#(lf)    ON i.ITEMGROUP = m.PROD_CODE#(lf)WHERE i.ITEM_TYPE IN ('ZFIN', 'ZSFG')#(lf)AND i.ITEM_SAP  NOT LIKE 'NPI%'#(lf)ORDER BY i.active DESC", CreateNavigationProperties=false]),
				    Removed_IG_Duplicates = Table.Distinct(Origen, {"ITEMGROUP"})
				in
				    Removed_IG_Duplicates

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

