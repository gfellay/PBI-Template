	column Column
		isHidden
		formatString: 0
		lineageTag: 400aaefb-1f78-4329-8955-05e56ab87269
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Metrics = calculated
		mode: import
		source =
				ROW(
					"Column", BLANK()
				)

	annotation PBI_Id = cb5208f190ad4297a158c8a004c20bb6

